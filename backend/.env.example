APP_NAME=MediFlow
DEBUG=true

# OCI Object Storage
OCI_NAMESPACE=tu_namespace_aqui
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..tu_compartment_aqui
OCI_REGION=sa-saopaulo-1

# Modo local: ruta al archivo de config y la private key
OCI_CONFIG_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Modo produccion (Render/deploy): credenciales por variable de entorno
# Si estas variables estan definidas, se usan en vez del archivo .pem
# Para obtener el base64 de tu key: base64 -i ~/.oci/oci_api_key.pem
# OCI_USER=ocid1.user.oc1..xxxxx
# OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff
# OCI_TENANCY=ocid1.tenancy.oc1..xxxxx
# OCI_PRIVATE_KEY_BASE64=contenido_base64_de_tu_pem

# Buckets
BUCKET_RECIBIDOS=mediflow-recibidos
BUCKET_PROCESADOS=mediflow-procesados
BUCKET_AUDITORIA=mediflow-auditoria

# LLM Gemini
LLM_PROVIDER=gemini-3.8-flash
LLM_API_KEY=tu_api_key_aqui

