# ==============================================================================
# MediFlow Backend - Plantilla de Variables de Entorno (.env)
# ==============================================================================
# Copie este archivo como '.env' en la carpeta backend/ y configure los valores.
# En desarrollo: cp .env.example .env

# ------------------------------------------------------------------------------
# Configuración General del Servidor
# ------------------------------------------------------------------------------
APP_NAME=MediFlow
DEBUG=true

# ------------------------------------------------------------------------------
# Base de Datos
# ------------------------------------------------------------------------------
# Entorno local: SQLite asíncrono (crea automáticamente mediflow.db)
DATABASE_URL=sqlite+aiosqlite:///./mediflow.db

# Entorno de producción: PostgreSQL asíncrono (descomentar para producción)
# DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/mediflow

# ------------------------------------------------------------------------------
# Seguridad, Autenticación y CORS
# ------------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT (OBLIGATORIO: cambiar en producción, mín. 32 caracteres)
JWT_SECRET_KEY=mediflow-dev-secret-cambiar-en-prod

# Orígenes autorizados para CORS (separados por coma).
# En desarrollo se permite '*' o puertos locales. En producción NO se permite '*' por seguridad.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Modelos de Inteligencia Artificial (LLM & Visión)
# ------------------------------------------------------------------------------
# Google Gemini: Clasificación y extracción clínica (obtener en: https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini-3.8-flash
LLM_API_KEY=tu_api_key_de_gemini_aqui

# Groq: Procesamiento multimodal de imágenes (obtener en: https://console.groq.com/keys)
API_KEY_GROQ=tu_api_key_de_groq_aqui
MODEL_GROQ=llama-3.2-11b-vision-preview

# Umbral de confianza mínimo (rango 0.0 a 1.0) para aprobar triaje sin auditoría humana.
# Si el agente obtiene una confianza menor, el caso se envía al bucket de auditoría.
UMBRAL_CONFIANZA_MINIMO=0.75

# Extensiones de archivos permitidas para triaje
EXTENSIONES_ARCHIVOS=["pdf", "png", "jpg", "jpeg"]

# ------------------------------------------------------------------------------
# Oracle Cloud Infrastructure (OCI) - Object Storage
# ------------------------------------------------------------------------------
# Identificadores de tenant y compartimento en OCI
OCI_NAMESPACE=tu_namespace_aqui
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..tu_compartment_aqui

# Región de OCI: sa-saopaulo-1 (por defecto) o sa-bogota-1 (alternativa Colombia)
OCI_REGION=sa-saopaulo-1
# OCI_REGION=sa-bogota-1

# --- Modo 1: Desarrollo Local (archivo de configuración local de OCI CLI) ---
OCI_CONFIG_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# --- Modo 2: Producción / Despliegue en la nube (Render, Railway, VPS) ---
# Si estas variables están definidas, se utilizan directamente sin necesidad de ~/.oci/config.
# Para obtener OCI_PRIVATE_KEY_BASE64:
#   Linux/Mac: base64 -w 0 ~/.oci/oci_api_key.pem
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("$HOME\.oci\oci_api_key.pem"))
# OCI_USER=ocid1.user.oc1..tu_usuario_ocid
# OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
# OCI_TENANCY=ocid1.tenancy.oc1..tu_tenancy_ocid
# OCI_PRIVATE_KEY_BASE64=contenido_base64_de_tu_pem

# ------------------------------------------------------------------------------
# Buckets de OCI Object Storage por Estado del Documento
# ------------------------------------------------------------------------------
BUCKET_RECIBIDOS=mediflow-recibidos
BUCKET_PROCESADOS=mediflow-procesados
BUCKET_AUDITORIA=mediflow-auditoria

